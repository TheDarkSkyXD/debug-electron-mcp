{
  "name": "@debugelectron/debug-electron-mcp",
  "version": "1.7.0",
  "description": "MCP server for Electron application automation and management. See MCP_USAGE_GUIDE.md for proper argument structure examples.",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "debug-electron-mcp": "dist/index.js"
  },
  "scripts": {
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "dev:inspect": "npm run build && npm run inspect",
    "dev:hmr": "mcpmon -- npm run dev",
    "build": "npm run typecheck && webpack --config webpack.config.cjs --mode production",
    "build:dev": "webpack --config webpack.config.cjs --mode development",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "watch": "webpack --config webpack.config.cjs --mode development --watch",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "deps:check:mature": "node scripts/check-package-age.mjs",
    "measure:mcp": "node --import tsx scripts/measure-mcp.mjs",
    "verify:mcp": "node scripts/verify-modern-mcp.mjs",
    "lint": "eslint src tests scripts eslint.config.ts vitest.config.mts --max-warnings=0",
    "lint:fix": "eslint src tests scripts eslint.config.ts vitest.config.mts --max-warnings=0 --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "code:check": "npm run lint && npm run format:check",
    "code:fix": "npm run lint:fix && npm run format"
  },
  "keywords": [
    "mcp",
    "electron",
    "automation",
    "desktop",
    "model-context-protocol",
    "devtools",
    "testing",
    "ai",
    "chrome-devtools-protocol",
    "screenshot",
    "electron-automation"
  ],
  "author": "DebugElectron",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "^1.62.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boundaries/eslint-plugin": "7.2.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^20.19.10",
    "@types/webpack": "^5.28.5",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/ws": "^8.5.14",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "electron": "43.4.0",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "globals": "^17.11.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "ts-loader": "^9.5.2",
    "tsx": "^4.6.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "4.1.10",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.2",
    "webpack-node-externals": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.8.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.8.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheDarkSkyXD/debug-electron-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TheDarkSkyXD/debug-electron-mcp/issues"
  },
  "homepage": "https://github.com/TheDarkSkyXD/debug-electron-mcp#readme"
}
