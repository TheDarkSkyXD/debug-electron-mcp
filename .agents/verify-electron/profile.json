{
  "version": 1,
  "projectName": "debug-electron-mcp-demo",
  "port": 9270,
  "launch": {
    "command": "node_modules/.bin/electron",
    "args": [
      "examples/demo-app",
      "--dev"
    ],
    "cwd": ".",
    "env": {
      "ELECTRON_DEBUG_PORT": "9270",
      "NODE_ENV": "development"
    },
    "readyTimeoutMs": 30000,
    "stripElectronRunAsNode": true
  },
  "target": {
    "title": "MCP Demo App",
    "urlIncludes": "examples/demo-app/index.html"
  },
  "evidenceRoot": ".verification/electron"
}
